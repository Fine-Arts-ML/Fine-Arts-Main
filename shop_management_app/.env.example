# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shop_management
DB_USER=postgres
DB_PASSWORD=postgres

# Nextcloud Configuration (for preview images)
NC_HOST=localhost
NC_ACC=your_nextcloud_user
NC_PASS=your_nextcloud_pass

# RAG Search Service Configuration
RAG_SERVICE_URL=http://localhost:8079
DEFAULT_MODEL=qwen3-0.6b
MODELS_DIR=./models
INDEX_DIR=./tfidf-index
MAX_CACHED_MODELS=1

# Hash Calculation Service Configuration (reverse image search)
HASH_SERVICE_URL=http://localhost:8078

# Authentication
SESSION_SECRET=your-random-secret-key-here-at-least-32-characters
DEFAULT_ROLE=user
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Admin Seeding (disable after initial setup)
SEED_ADMIN_ENABLED=true

# Cloudflare Tunnel (for production HTTPS)
# Get your token from: https://dash.cloudflare.com/?to=academy/courses/cloudflare-tunnel
# Set this to your Cloudflare Tunnel token for encrypted HTTPS access
# Leave empty or unset to use HTTP (development only)
CLOUDFLARE_TOKEN=
